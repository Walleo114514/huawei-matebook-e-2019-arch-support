--- a/drivers/soundwire/qcom.c
+++ b/drivers/soundwire/qcom.c
@@ -614,7 +614,13 @@
 
 		sdw_extract_slave_id(bus, addr, &id);
 		found = false;
-		ctrl->clock_stop_not_supported = false;
+		/*
+		 * WSA SoundWire masters (v1.3.0) do not support clock stop, so
+		 * keep the flag that qcom_swrm_probe() set for them.  For newer
+		 * controllers fall back to the per-slave capability.
+		 */
+		if (ctrl->version > SWRM_VERSION_1_3_0)
+			ctrl->clock_stop_not_supported = false;
 		/* Now compare with entries */
 		list_for_each_entry_safe(slave, _s, &bus->slaves, node) {
 			if (sdw_compare_devid(slave, id) == 0) {
@@ -1579,6 +1585,16 @@
 
 	ctrl->reg_read(ctrl, SWRM_COMP_HW_VERSION, &ctrl->version);
 
+	/*
+	 * Clock stop is not supported on WSA SoundWire masters (v1.3.0), which
+	 * is what drives the WSA881x speaker amplifiers on SDM845.  Doing a
+	 * clock stop on this link detaches the amplifiers and they never come
+	 * back after a system suspend.  Skip clock stop and use a full reset +
+	 * re-enumeration on resume instead.
+	 */
+	if (ctrl->version <= SWRM_VERSION_1_3_0)
+		ctrl->clock_stop_not_supported = true;
+
 	ret = devm_request_threaded_irq(dev, ctrl->irq, NULL,
 					qcom_swrm_irq_handler,
